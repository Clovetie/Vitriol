--!nonstrict
-- ReplicatedStorage/Tidekeeper/Domain/Ledger (ModuleScript)
--
-- Layer L2: pure. No services, no Instances, no yields, no time reads.
--
-- The Ledger is the game (doc 04 section 7): it is not a log of what happened,
-- it is the REPLAY the player actually watches when they come back. Its
-- quality is the product's quality.
--
-- An entry is `(templateId, epoch, actorId, slots[])`. No prose is stored --
-- only the template id and the numbers to substitute. Three reasons:
--   * 24 bytes instead of ~120, and a post keeps 200 of them;
--   * the copy can be rewritten, translated or fixed after the fact and every
--     historical entry improves;
--   * prose generated at runtime from numbers is deterministic; prose
--     generated by a language model is not, and this game replays.
--
-- SCOPE: iteration 2 ships the SELECTION MACHINERY and 12 representative
-- templates. Doc 04 section 4.1 requires >= 40 by iteration 4 and >= 180 at
-- v1. The decision table below is the contract those templates plug into; the
-- table does not change when the copy does.

local GameConfig = require(script.Parent.Parent.Config.GameConfig)

local Ledger = {}

local MAX_SLOTS = GameConfig.MAX_LEDGER_SLOTS

-- Outcome codes. These are wire values (doc 05 section 5) -- never renumber.
Ledger.SERVED = 1
Ledger.REFUSED = 2
Ledger.PARTIAL = 3
Ledger.MISSED_TIDE = 4
Ledger.NO_BERTH = 5

Ledger.OUTCOME_NAMES = { "SERVED", "REFUSED", "PARTIAL", "MISSED_TIDE", "NO_BERTH" }

function Ledger.outcomeName(outcome)
	local name = Ledger.OUTCOME_NAMES[outcome]
	if name == nil then
		return "UNKNOWN"
	end
	return name
end

-- Template ids are stable forever. Ranges are reserved by kind so iteration 4
-- can add 40 without renumbering anything:
--   1..199    visit outcomes
--   200..249  epoch summaries
--   250..299  system events (long absence, tier up, season)
Ledger.T_SERVED_PLAIN = 1
Ledger.T_SERVED_WANT = 2
Ledger.T_SERVED_WARM = 3
Ledger.T_SERVED_SOUR_PRICE = 4
Ledger.T_SERVED_FIRST_FIND = 5
Ledger.T_PARTIAL_BUDGET = 6
Ledger.T_REFUSED_GATE = 7
Ledger.T_REFUSED_COLD = 8
Ledger.T_MISSED_TIDE = 9
Ledger.T_MISSED_TIDE_DEEPWATER = 10
Ledger.T_NO_BERTH = 11
Ledger.T_GIFT = 12
Ledger.T_EPOCH_SUMMARY = 200
Ledger.T_EPOCH_QUIET = 201
Ledger.T_LONG_ABSENCE = 250

-- Slot arity per template. The renderer asserts against this, so a template
-- that grows a slot cannot silently render "{item}" as literal text.
Ledger.SLOT_COUNT = {
	[1] = 3,
	[2] = 3,
	[3] = 4,
	[4] = 3,
	[5] = 3,
	[6] = 4,
	[7] = 2,
	[8] = 2,
	[9] = 2,
	[10] = 1,
	[11] = 1,
	[12] = 3,
	[200] = 4,
	[201] = 1,
	[250] = 3,
}

-- Warmth bands used by the decision table. Kept here rather than in
-- EconomyConfig because they are a narrative device, not an economic one.
Ledger.WARM = 60
Ledger.COLD = -20

-- The decision table of doc 04 section 4.1, as code. `ctx` carries only what
-- the table reads, so the client's Ledger preview can call it with a
-- hypothetical.
--
-- Order matters: the most specific rule wins, which is why this is a ladder
-- and not a lookup.
function Ledger.selectTemplate(outcome, ctx)
	if outcome == Ledger.MISSED_TIDE then
		if ctx.class == 3 then
			return Ledger.T_MISSED_TIDE_DEEPWATER
		end
		return Ledger.T_MISSED_TIDE
	end
	if outcome == Ledger.NO_BERTH then
		return Ledger.T_NO_BERTH
	end
	if outcome == Ledger.REFUSED then
		if ctx.gatedByStanding then
			return Ledger.T_REFUSED_GATE
		end
		return Ledger.T_REFUSED_COLD
	end
	if outcome == Ledger.PARTIAL then
		return Ledger.T_PARTIAL_BUDGET
	end
	-- SERVED
	if ctx.gifted then
		return Ledger.T_GIFT
	end
	if ctx.firstFind then
		return Ledger.T_SERVED_FIRST_FIND
	end
	if ctx.sourPrice then
		return Ledger.T_SERVED_SOUR_PRICE
	end
	if ctx.warmth > Ledger.WARM and ctx.metWant then
		return Ledger.T_SERVED_WANT
	end
	if ctx.warmth > Ledger.WARM then
		return Ledger.T_SERVED_WARM
	end
	return Ledger.T_SERVED_PLAIN
end

-- Build an entry. `slots` is a dense array of integers -- ids and quantities,
-- never strings. The renderer turns slot 1 of template 2 into a find name;
-- this layer does not know what a name is.
function Ledger.entry(templateId, epoch, actorId, slots)
	local n = 0
	if slots ~= nil then
		n = #slots
	end
	local expected = Ledger.SLOT_COUNT[templateId]
	if expected ~= nil and n ~= expected then
		return nil, string.format("template %d expects %d slots, got %d", templateId, expected, n)
	end
	if n > MAX_SLOTS then
		return nil, string.format("template %d has %d slots, maximum is %d", templateId, n, MAX_SLOTS)
	end
	local copy = {}
	for i = 1, n do
		copy[i] = slots[i]
	end
	return { templateId = templateId, epoch = epoch, actorId = actorId, slots = copy }, nil
end

-- Append, keeping the list bounded and newest-last. Older pages are fetched on
-- demand (doc 01 section 6), so dropping from the front here is correct.
function Ledger.append(list, entry, maxResident)
	local cap = maxResident or GameConfig.MAX_LEDGER_RESIDENT
	list[#list + 1] = entry
	local overflow = #list - cap
	if overflow > 0 then
		for i = 1, #list - overflow do
			list[i] = list[i + overflow]
		end
		for i = #list - overflow + 1, #list do
			list[i] = nil
		end
	end
	return list
end

-- Group a flat entry list into `{ epoch = n, entries = {...} }` pages,
-- ascending by epoch. Entries are already in epoch order coming out of
-- Resolve, so this is a single pass and preserves within-epoch order.
function Ledger.groupByEpoch(entries)
	local groups = {}
	local count = 0
	local currentEpoch = nil
	for i = 1, #entries do
		local entry = entries[i]
		if currentEpoch == nil or entry.epoch ~= currentEpoch then
			count = count + 1
			groups[count] = { epoch = entry.epoch, entries = {} }
			currentEpoch = entry.epoch
		end
		local bucket = groups[count].entries
		bucket[#bucket + 1] = entry
	end
	return groups
end

function Ledger.isValid(entry)
	if type(entry) ~= "table" then
		return false, "entry is not a table"
	end
	if type(entry.templateId) ~= "number" or entry.templateId < 1 or entry.templateId > 65535 then
		return false, "templateId out of range"
	end
	if type(entry.epoch) ~= "number" then
		return false, "epoch is not a number"
	end
	if type(entry.slots) ~= "table" then
		return false, "slots is not an array"
	end
	if #entry.slots > MAX_SLOTS then
		return false, "too many slots"
	end
	local expected = Ledger.SLOT_COUNT[entry.templateId]
	if expected ~= nil and #entry.slots ~= expected then
		return false, string.format("template %d expects %d slots", entry.templateId, expected)
	end
	return true
end

return Ledger
